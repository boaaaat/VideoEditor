{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://ai-video-editor.local/schemas/command.schema.json",
  "type": "object",
  "required": ["type"],
  "properties": {
    "type": {
      "enum": [
        "import_media",
        "remove_media",
        "add_track",
        "update_track",
        "delete_track",
        "add_clip",
        "move_clip",
        "trim_clip",
        "split_clip",
        "delete_clip",
        "ripple_delete_clip",
        "apply_color_adjustment",
        "apply_audio_adjustment",
        "apply_clip_speed",
        "apply_transform",
        "apply_effect_stack",
        "apply_lut",
        "export_timeline"
      ]
    },
    "history": {
      "type": "object",
      "properties": {
        "mode": { "enum": ["push", "replace", "none"] },
        "group": { "type": "string", "minLength": 1 }
      },
      "additionalProperties": false
    }
  },
  "allOf": [
    {
      "if": { "properties": { "type": { "const": "ripple_delete_clip" } } },
      "then": {
        "required": ["clipId", "trackMode"],
        "properties": {
          "clipId": { "type": "string", "minLength": 1 },
          "trackMode": { "enum": ["selected_track", "all_tracks"] }
        }
      }
    },
    {
      "if": { "properties": { "type": { "const": "remove_media" } } },
      "then": {
        "required": ["mediaId"],
        "properties": {
          "mediaId": { "type": "string", "minLength": 1 }
        }
      }
    },
    {
      "if": { "properties": { "type": { "const": "import_media" } } },
      "then": {
        "required": ["paths"],
        "properties": {
          "paths": { "type": "array", "items": { "type": "string" }, "minItems": 1 },
          "copyToProject": { "type": "boolean" }
        }
      }
    },
    {
      "if": { "properties": { "type": { "const": "apply_clip_speed" } } },
      "then": {
        "required": ["clipId", "speedPercent"],
        "properties": {
          "clipId": { "type": "string", "minLength": 1 },
          "speedPercent": { "type": "number", "minimum": 25, "maximum": 400 }
        }
      }
    },
    {
      "if": { "properties": { "type": { "const": "export_timeline" } } },
      "then": {
        "required": ["outputPath", "resolution", "width", "height", "fps", "codec", "container", "quality", "bitrateMbps", "audioEnabled", "colorMode"],
        "properties": {
          "outputPath": { "type": "string", "minLength": 1 },
          "resolution": { "enum": ["source", "custom", "1080p", "1440p", "4k"] },
          "width": { "type": "integer", "minimum": 1 },
          "height": { "type": "integer", "minimum": 1 },
          "fps": { "enum": [24, 25, 30, 50, 60] },
          "codec": { "enum": ["h264_nvenc", "hevc_nvenc", "av1_nvenc"] },
          "container": { "enum": ["mp4", "mkv"] },
          "quality": { "enum": ["trash", "low", "medium", "high", "pro_max"] },
          "bitrateMbps": { "type": "number", "minimum": 1 },
          "encoderOptions": {
            "type": "object",
            "required": ["enabled", "preset", "tune", "cq", "maxBitrateMbps", "lookaheadDepth", "lookaheadLevel", "multipass", "spatialAq", "temporalAq", "aqStrength", "bFrames", "bRefMode", "referenceFrames", "highBitDepth", "splitEncodeMode"],
            "properties": {
              "enabled": { "type": "boolean" },
              "preset": { "enum": ["p1", "p2", "p3", "p4", "p5", "p6", "p7"] },
              "tune": { "enum": ["hq", "uhq"] },
              "cq": { "type": "number", "minimum": 0, "maximum": 63 },
              "maxBitrateMbps": { "type": "number", "minimum": 1, "maximum": 2000 },
              "lookaheadDepth": { "type": "integer", "minimum": 0, "maximum": 32 },
              "lookaheadLevel": { "type": "integer", "minimum": 0, "maximum": 3 },
              "multipass": { "enum": ["disabled", "qres", "fullres"] },
              "spatialAq": { "type": "boolean" },
              "temporalAq": { "type": "boolean" },
              "aqStrength": { "type": "integer", "minimum": 1, "maximum": 15 },
              "bFrames": { "type": "integer", "minimum": 0, "maximum": 5 },
              "bRefMode": { "enum": ["disabled", "each", "middle"] },
              "referenceFrames": { "type": "integer", "minimum": 1, "maximum": 16 },
              "highBitDepth": { "type": "boolean" },
              "splitEncodeMode": { "enum": ["auto", "disabled"] }
            },
            "additionalProperties": false
          },
          "audioEnabled": { "type": "boolean" },
          "colorMode": { "enum": ["SDR", "HDR"] }
        }
      }
    }
  ],
  "additionalProperties": true
}
